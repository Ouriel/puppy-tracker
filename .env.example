# PupPace Environment Configuration

# 1. Google OAuth SSO Client ID
# Generate this in Google Cloud Console (APIs & Services > Credentials)
# Set the Authorized JavaScript Origins to: http://localhost:5173 and your Vercel deployment URL
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 2. SaaS JWT Encryption Secret
JWT_SECRET=super-secret-saas-key
